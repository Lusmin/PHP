<?php

$num1 =readline("Digite o primeiro número: ");
$num2 =readline("Digite o segundo número: ");

$soma = $num1 + $num2;
$sub = $num1 - $num2;
$mult = $num1 * $num2;
$divs = $num1 / $num2;
$modl = $num1 % $num2;

echo("Soma:") . $soma ."\n";
echo("Subtração:") . $sub . "\n";
echo("Multiplicação:") . $mult . "\n";
echo("Divisão:") . $divs  . "\n";
echo("Módulo:") . $modl;

?>
