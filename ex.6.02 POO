<?php

class livro{
    public $titulo;
    public $autor;
    public $paginas;
    
    public function construct(string $titulo, string $autor, int $paginas){
        $this -> titul = $titulo;
        $this -> autor = $autor;
        $this -> paginas = $paginas;
    }
}
    

$livro1 = new livro();
$livro1 -> titulo= "Coraline";
$livro1 -> autor = "Neil Gaiman";
$livro1 -> paginas = 224;


$livro2 = new livro();
$livro2 -> titulo = "Sandman";
$livro2 -> autor = "Neil Gaiman";
$livro2 -> paginas = 2000;

echo "============================================================";
echo "\n O livro " . $livro1 -> titulo . " e " . $livro2 -> titulo;
echo "\n são do mesmo autor " . "'" . $livro1 -> autor . "'";
